# Copy to .env.local to override. Never commit real secrets.
# Backend origin for API calls. Leave empty in development to use the Vite proxy
# (requests to /api go to http://localhost:5035).
VITE_API_BASE_URL=

# Where cases and patients come from: "demo" (default, local demo data) or
# "api" (backend). Use "api" only once the cases endpoints exist.
VITE_CASES_SOURCE=demo
